{
  "expo": {
    "name": "zaeli",
    "slug": "zaeli",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zaeli",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF8F5",
      "dark": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FAF8F5"
      }
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Zaeli uses your camera to scan products and receipts.",
        "NSPhotoLibraryUsageDescription": "Zaeli can add items from photos in your library.",
        "NSCalendarsUsageDescription": "Zaeli syncs with your iPhone Calendar so you see all your events in one place — and your Zaeli events appear on your iPhone Calendar too.",
        "NSCalendarsFullAccessUsageDescription": "Zaeli reads events from calendars you choose and writes Zaeli events into a dedicated Zaeli calendar on your phone. Two-way sync — you stay in control of which calendars.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.zaeli.app",
      "associatedDomains": ["applinks:zaeli.app"],
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FAF8F5",
        "tabletImage": "./assets/images/splash-icon.png",
        "tabletBackgroundColor": "#FAF8F5",
        "dark": {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F5"
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.zaeli.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F5",
          "dark": {
            "backgroundColor": "#FAF8F5"
          }
        }
      ],
      [
        "expo-system-ui",
        {
          "backgroundColor": "#FAF8F5"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Zaeli can add items from photos in your library.",
          "cameraPermission": "Zaeli uses your camera to scan products and receipts."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0057FF"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Zaeli syncs with your iPhone Calendar so you see all your events in one place — and your Zaeli events appear on your iPhone Calendar too."
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d9529bc9-9bb0-448f-8b1a-f259b6cd6afb"
      }
    }
  }
}
